import test from "node:test";
import assert from "node:assert/strict";
import { readFileSync } from "node:fs";
import { calculateLanguageFit, extractJobLanguageRequirement, type LanguageEvidence } from "../lib/evidence/language.ts";
import { assessWorkAuthorization, type WorkAuthorizationEvidence } from "../lib/evidence/workAuthorization.ts";
import { assessEvidenceFreshness } from "../lib/evidence/freshness.ts";
import { calculateEducationMatch, calculateExperienceMatch, extractEducationRequirement, extractExperienceRequirement } from "../lib/evidence/requirements.ts";
import { normalizeSalary } from "../lib/evidence/salary.ts";
import { calculateProfileCompleteness } from "../lib/personalization/profileCompleteness.ts";
import { detectMeaningfulOpportunityChanges } from "../lib/monitoring/opportunityMonitoring.ts";
import { calculateJobMatch } from "../lib/jobs/jobMatching.ts";
import type { JobPosting } from "../lib/jobs/types.ts";

const provenance = { sourceName: "Authority", sourceUrl: "https://authority.example/rule", authority: "government" as const, retrievedAt: "2026-08-01T00:00:00Z", effectiveFrom: "2026-01-01", referencePeriod: "2026", geography: "Sweden", careerSlug: null, confidence: "high" as const, status: "published" as const };
const language: LanguageEvidence = { primaryWorkplaceLanguage: "Swedish", usefulLanguages: ["English"], englishOnlyRealistic: true, localLanguageImportance: "high", recommendedProficiency: "B2", requirementLevel: "market-expectation", provenance };
test("published language evidence scores stated languages and missing evidence remains null", () => { assert.equal(calculateLanguageFit(["Swedish"], language).score, 100); assert.equal(calculateLanguageFit(["English"], null).score, null); assert.equal(calculateLanguageFit(["English"], { ...language, provenance: { ...provenance, status: "review" } }).score, null); });
test("job language requirements come only from posting text", () => { assert.equal(extractJobLanguageRequirement("Swedish is required")?.language, "Swedish"); assert.equal(extractJobLanguageRequirement("Collaborative engineering role"), null); });
test("work authorization is derived from published evidence and stale rules lower confidence", () => { const evidence: WorkAuthorizationEvidence = { originRegion: "non-eea", destinationCountry: "sweden", permitRequirement: "required", employerSponsorship: "relevant", jobOfferRequired: true, salaryThreshold: null, qualificationRequirement: null, occupationRestrictions: [], processingComplexity: "medium", provenance: { ...provenance, retrievedAt: "2024-01-01T00:00:00Z" } }; const result = assessWorkAuthorization(evidence, new Date("2026-08-25T00:00:00Z")); assert.equal(result.freshness?.state, "stale"); assert.equal(result.score, 38); assert.match(result.legalNotice, /not legal advice/); assert.equal(assessWorkAuthorization(null).score, null); });
test("experience and education requirements are extracted only when stated", () => { const exp = extractExperienceRequirement("Minimum 3 years of relevant experience required."); assert.equal(exp?.minimumYears, 3); assert.equal(calculateExperienceMatch(2, exp).score, 67); const education = extractEducationRequirement("Required bachelor's degree in Mechanical Engineering"); assert.equal(calculateEducationMatch("Master's degree", education).score, 100); assert.equal(extractExperienceRequirement("Grow with our team"), null); });
test("salary normalization preserves native evidence through conversion and FX failure", () => { const normalized = normalizeSalary(100, "SEK", "EUR", { rate: 0.09, timestamp: "2026-08-25", source: "ECB" }); assert.deepEqual([normalized.nativeValue, normalized.nativeCurrency, normalized.normalizedValue, normalized.fxRate], [100, "SEK", 9, 0.09]); const failed = normalizeSalary(100, "SEK", "EUR", null); assert.equal(failed.nativeValue, 100); assert.equal(failed.normalizedValue, null); });
test("freshness rules are deterministic", () => { assert.equal(assessEvidenceFreshness({ retrievedAt: "2026-01-01" }, new Date("2026-08-25"), 365, 730).state, "current"); assert.equal(assessEvidenceFreshness({ retrievedAt: "bad" }).state, "unknown"); });
test("profile completeness weights recommendation value and identifies one next field", () => { const result = calculateProfileCompleteness({ currentCountry: null, targetCountries: [], currentCareer: null, yearsExperience: null, educationLevel: null, skills: [], desiredSalary: null, desiredSalaryCurrency: null, remotePreference: "neutral", relocationWillingness: "maybe", careerGoals: null, languages: [] }); assert.equal(result.score, 8); assert.equal(result.nextBestField, "currentCareer"); });
test("monitoring ignores noise and reports deterministic meaningful changes", () => { const base = { score: 70, salaryTypical: 100, demandScore: 60, liveJobCount: 20, relocationEvidenceVersion: "a", scoreVersion: "1.1" }; assert.deepEqual(detectMeaningfulOpportunityChanges(base, { ...base, score: 74, salaryTypical: 104 }), []); assert.deepEqual(detectMeaningfulOpportunityChanges(base, { ...base, score: 75, liveJobCount: 25 }).map((item) => item.type), ["opportunity_score", "jobs"]); });
test("monitoring never compares incompatible salary evidence", () => { const previous = { score: null, salaryTypical: 100, salaryCurrency: "SEK", salaryPeriod: "year" as const, demandScore: null, liveJobCount: null, relocationEvidenceVersion: null, scoreVersion: "1.1" }; assert.deepEqual(detectMeaningfulOpportunityChanges(previous, { ...previous, salaryTypical: 200, salaryCurrency: "EUR" }), []); assert.deepEqual(detectMeaningfulOpportunityChanges(previous, { ...previous, salaryTypical: 106 }).map((item) => item.type), ["salary"]); });
test("Job Match V2 uses only sourced partial requirements and reports coverage", () => { const job: JobPosting = { id: "1", provider: "test", sourceName: "Employer", sourceUrl: "https://example.com", title: "Engineer", company: "A", countryCode: "SE", countryName: "Sweden", city: null, locationText: "Sweden", workplaceType: "hybrid", employmentType: null, description: "Minimum 3 years of relevant experience. Swedish is required. Required bachelor's degree in Engineering.", skills: ["Python"], publishedAt: null, expiresAt: null, salaryMin: null, salaryMax: null, salaryCurrency: null, salaryPeriod: null, applyUrl: "https://example.com", originalUrl: "https://example.com", careerSlug: "engineer", providerMetadata: {} }; const result = calculateJobMatch(job, { careerSlug: "engineer", skills: ["Python"], yearsExperience: 4, educationLevel: "Master's", languages: ["Swedish"] }); assert.equal(result.breakdown.experienceMatch, 100); assert.equal(result.breakdown.educationMatch, 100); assert.equal(result.breakdown.languageFit, 100); assert.ok(result.evidenceCoverage >= 70); });
test("phase 2 migration keeps evidence review-first and user records private", () => { const sql = readFileSync("supabase/migrations/20260825090000_phase2_intelligence_billing.sql", "utf8"); assert.match(sql, /review_status text not null default 'draft'/); assert.match(sql, /Users read their subscription/); assert.match(sql, /Users read their opportunity watches/); assert.match(sql, /user_id = auth\.uid\(\)/); assert.doesNotMatch(sql, /grant (insert|update|delete).*user_subscriptions.*authenticated/i); assert.doesNotMatch(sql, /grant (insert|update|delete).*opportunity_watches.*authenticated/i); assert.match(sql, /revoke all privileges on table .*billing_webhook_events/i); });
