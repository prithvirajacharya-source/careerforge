import test from "node:test";import assert from "node:assert/strict";import{readFileSync}from"node:fs";import{normalizeNorwaySalaryResponse}from"../lib/careerResearch/norway.ts";import{normalizeFinlandSalaryResponse}from"../lib/careerResearch/finland.ts";import{getCareerResearchTarget,isCareerResearchSupported}from"../lib/careerResearch/registry.ts";import{validateCareerResearchPublication}from"../lib/careerResearch/publishing.ts";
const fixture=(name:string)=>JSON.parse(readFileSync(new URL(`./fixtures/${name}`,import.meta.url),"utf8"));
test("Norway proof mappings normalize official quartiles in native NOK",()=>{const mechanical=getCareerResearchTarget("mechanical-engineer","norway")!;const nurse=getCareerResearchTarget("registered-nurse","norway")!;const m=normalizeNorwaySalaryResponse(fixture("ssb-11418-proof.json"),mechanical,"2026-08-15T00:00:00Z");const n=normalizeNorwaySalaryResponse(fixture("ssb-11418-proof.json"),nurse,"2026-08-15T00:00:00Z");assert.deepEqual([m.salary.low.value,m.salary.typical.value,m.salary.high.value],[71870*12,87200*12,105820*12]);assert.deepEqual([n.salary.low.value,n.salary.typical.value,n.salary.high.value],[58180*12,63810*12,70030*12]);assert.equal(m.salary.sourceCurrency,"NOK")});
test("Finland proof mappings normalize official deciles in native EUR",()=>{const mechanical=getCareerResearchTarget("mechanical-engineer","finland")!;const nurse=getCareerResearchTarget("registered-nurse","finland")!;const m=normalizeFinlandSalaryResponse(fixture("statfin-15au-proof.json"),mechanical,"2026-08-15T00:00:00Z");const n=normalizeFinlandSalaryResponse(fixture("statfin-15au-proof.json"),nurse,"2026-08-15T00:00:00Z");assert.deepEqual([m.salary.low.value,m.salary.typical.value,m.salary.high.value],[3453*12,4702*12,6735*12]);assert.deepEqual([n.salary.low.value,n.salary.typical.value,n.salary.high.value],[3631*12,4198*12,5150*12]);assert.equal(m.salary.sourceCurrency,"EUR")});
test("only four validated Nordic proof targets are enabled and publishing stays disabled",()=>{assert.equal(isCareerResearchSupported("mechanical-engineer","norway"),true);assert.equal(isCareerResearchSupported("registered-nurse","finland"),true);assert.equal(isCareerResearchSupported("software-engineer","norway"),false);const target=getCareerResearchTarget("mechanical-engineer","norway")!;const candidate=normalizeNorwaySalaryResponse(fixture("ssb-11418-proof.json"),target,"2026-08-15T00:00:00Z");assert.throws(()=>validateCareerResearchPublication({id:1,status:"approved",career_slug:target.careerSlug,country_slug:target.countrySlug,schema_version:"career-research-v1",candidate_profile:candidate}),/Publishing supports only/)});
