import test from "node:test";
import assert from "node:assert/strict";
import { normalizeJobTechHit, createJobTechProvider } from "../lib/jobs/providers/jobtech.ts";
import { deduplicateJobs } from "../lib/jobs/jobDeduplication.ts";
import { parseJobSearchParams, searchJobs } from "../lib/jobs/searchJobs.ts";
import { extractSkills } from "../lib/jobs/skills.ts";
import { calculateJobMatch } from "../lib/jobs/jobMatching.ts";
import { recommendForMissingSkills, recommendStudyResources } from "../lib/learning/recommendStudyResources.ts";
import type { JobProvider } from "../lib/jobs/types.ts";
import { COUNTRY_CATALOG } from "../lib/countryCatalog.ts";
import { getJobProviders } from "../lib/jobs/jobProviderRegistry.ts";
import { ADZUNA_MARKETS, createAdzunaProvider, normalizeAdzunaJob } from "../lib/jobs/providers/adzuna.ts";
import { readFileSync } from "node:fs";

const hit = { id: "123", webpage_url: "https://arbetsformedlingen.se/jobs/123", headline: "Mechanical Engineer", description: { text: "Use Python, CATIA and finite element analysis." }, employer: { name: "Example AB" }, workplace_address: { city: "Göteborg", region: "Västra Götaland" }, employment_type: { label: "Permanent" }, publication_date: "2026-08-01T10:00:00Z", application_deadline: "2026-09-01", application_details: { url: "https://example.com/apply" }, must_have: { skills: [] }, nice_to_have: { skills: [] } };
const job = normalizeJobTechHit(hit, "mechanical-engineer");

test("JobTech normalization preserves source data and extracts skills", () => { assert.equal(job.company, "Example AB"); assert.equal(job.city, "Göteborg"); assert.equal(job.applyUrl, "https://example.com/apply"); assert.deepEqual(job.skills.sort(), ["CATIA", "FEA", "Python"].sort()); });
test("deduplication prefers richer duplicate", () => { const sparse = { ...job, description: null, skills: [] }; assert.deepEqual(deduplicateJobs([sparse, job]), [job]); });
test("search parameter validation bounds upstream work", () => { assert.throws(() => parseJobSearchParams(new URLSearchParams("limit=100")), /limit/); assert.equal(parseJobSearchParams(new URLSearchParams("career=mechanical-engineer&country=sweden")).q, "mechanical engineer"); });
test("skill extraction is case insensitive and synonym aware", () => { assert.deepEqual(extractSkills("Experience with python and FEM is required."), ["Python", "FEA"]); });
test("job matching is deterministic and transparent", () => { const match = calculateJobMatch(job, { careerSlug: "mechanical-engineer", skills: ["Python", "CATIA"] }); assert.equal(typeof match.score, "number"); assert.deepEqual(match.matchedSkills.sort(), ["CATIA", "Python"]); assert.deepEqual(match.missingSkills, ["FEA"]); assert.ok(match.reasons.some((reason) => reason.includes("FEA"))); });
test("insufficient profile data does not manufacture a score", () => { assert.equal(calculateJobMatch(job, {}).score, null); });
test("title relevance alone cannot manufacture a high match", () => { assert.equal(calculateJobMatch(job, { careerSlug: "mechanical-engineer" }).score, null); });
test("missing advertised skills materially reduce a match", () => { const strong = calculateJobMatch(job, { careerSlug: "mechanical-engineer", skills: ["Python", "CATIA", "FEA"] }); const weak = calculateJobMatch(job, { careerSlug: "mechanical-engineer", skills: ["Python"] }); assert.equal(strong.score, 100); assert.ok((weak.score ?? 100) < 75); });
test("study resources map only to relevant skills", () => { const results = recommendStudyResources(["Python"], 5); assert.ok(results.length > 0); assert.ok(results.every((item) => item.matchedSkills.includes("Python"))); });
test("missing skill maps to verified learning resource", () => { const results = recommendForMissingSkills(["FEA"]); assert.equal(results[0].resource.provider, "Ansys"); });
test("one provider failure does not discard another provider", async () => { const good: JobProvider = { id: "good", name: "Good", countries: ["sweden"], async search() { return { jobs: [job], total: 1, hasMore: false }; } }; const bad: JobProvider = { id: "bad", name: "Bad", countries: ["sweden"], async search() { throw new Error("offline"); } }; const input = parseJobSearchParams(new URLSearchParams("q=engineer")); const result = await searchJobs(input, [bad, good]); assert.equal(result.results.length, 1); assert.equal(result.providerErrors[0].provider, "Bad"); });
test("JobTech provider handles mocked official response", async () => { const provider = createJobTechProvider(async () => new Response(JSON.stringify({ total: { value: 1 }, hits: [hit] }), { status: 200 })) as JobProvider; const result = await provider.search(parseJobSearchParams(new URLSearchParams("q=engineer&limit=1"))); assert.equal(result.jobs[0].id, "jobtech:123"); });
test("Jobs uses every canonical country plus an all-countries option", () => { const client = readFileSync("components/jobs/JobsSearchClient.tsx", "utf8"); assert.match(client, /<option value="all">All countries<\/option>/); assert.match(client, /COUNTRY_CATALOG\.map/); assert.equal(COUNTRY_CATALOG.length, 29); for (const slug of ["sweden", "united-states", "germany", "poland", "united-kingdom", "netherlands", "canada", "australia"]) assert.ok(COUNTRY_CATALOG.some((country) => country.slug === slug)); });
test("provider selection is global but remains honest for uncovered countries", async () => { assert.equal(getJobProviders("all").length, 1); assert.equal(getJobProviders("sweden").length, 1); assert.equal(getJobProviders("poland").length, 0); const result = await searchJobs(parseJobSearchParams(new URLSearchParams("country=poland"))); assert.equal(result.coverageAvailable, false); assert.deepEqual(result.results, []); });
test("specific-country searches cannot leak jobs from another country", async () => { const provider: JobProvider = { id: "wrong-market", name: "Wrong market", countries: ["poland"], async search() { return { jobs: [job], total: 1, hasMore: false }; } }; const result = await searchJobs(parseJobSearchParams(new URLSearchParams("country=poland")), [provider]); assert.deepEqual(result.results, []); });
test("all-countries search can retain jobs from multiple covered markets", async () => { const usJob = { ...job, id: "us:1", countryCode: "US", countryName: "United States", locationText: "Austin", applyUrl: "https://example.com/us/apply", originalUrl: "https://example.com/us/job" }; const providers: JobProvider[] = [{ id: "se", name: "Sweden", countries: ["sweden"], async search() { return { jobs: [job], total: 1, hasMore: false }; } }, { id: "us", name: "United States", countries: ["united-states"], async search() { return { jobs: [usJob], total: 1, hasMore: false }; } }]; const result = await searchJobs(parseJobSearchParams(new URLSearchParams("country=all")), providers); assert.deepEqual(new Set(result.results.map((item) => item.countryCode)), new Set(["SE", "US"])); assert.equal(result.results.find((item) => item.id === "us:1")?.locationText, "Austin, United States"); });
test("Adzuna markets normalize only to their configured countries and preserve source links", () => { for (const market of ADZUNA_MARKETS) { const normalized = normalizeAdzunaJob({ id: `job-${market.apiCode}`, title: "Mechanical Engineer", description: "Python and FEA", redirect_url: `https://www.adzuna.example/${market.apiCode}/job`, company: { display_name: "Example Employer" }, location: { display_name: "Capital Region" }, created: "2026-08-20T10:00:00Z" }, market, "mechanical-engineer"); assert.equal(normalized?.countryCode, market.countryCode); assert.equal(normalized?.countryName, market.countryName); assert.equal(normalized?.applyUrl, `https://www.adzuna.example/${market.apiCode}/job`); assert.equal(normalized?.sourceName, "Adzuna"); } });
test("Adzuna provider uses the configured market endpoint and bounded search", async () => { let requested = ""; const provider = createAdzunaProvider(ADZUNA_MARKETS[0], { appId: "test-id", appKey: "test-key" }, async (url) => { requested = String(url); return new Response(JSON.stringify({ count: 1, results: [{ id: "us-1", title: "Engineer", redirect_url: "https://example.com/job/us-1", location: { display_name: "Austin" } }] })); }); const result = await provider.search(parseJobSearchParams(new URLSearchParams("country=united-states&q=engineer&limit=5"))); assert.match(requested, /\/jobs\/us\/search\/1/); assert.match(requested, /results_per_page=5/); assert.equal(result.jobs[0].countryCode, "US"); });
test("registry enables all six Adzuna countries only when credentials are configured", () => { const credentials = { appId: "test-id", appKey: "test-key" }; assert.equal(getJobProviders("all", credentials).length, 7); for (const market of ADZUNA_MARKETS) { const providers = getJobProviders(market.slug, credentials); assert.equal(providers.length, 1); assert.deepEqual(providers[0].countries, [market.slug]); } });
test("invalid Adzuna records are discarded instead of becoming fake jobs", () => { assert.equal(normalizeAdzunaJob({ id: "missing-url", title: "Engineer" }, ADZUNA_MARKETS[0], null), null); });
